# Ember v3 — 环境变量模板（复制本文件为 .env 并填入真实值；.env 不入库）
# 各脚本启动时自动加载（load_env）。

# ---- 模型凭据：地址、模型与策略只在 config/models.json 配置 ----
# VL切片/认知向量与reranker
SILICONFLOW_API_KEY=
# 第三方维护
ZHIPU_MAINTENANCE_API_KEY=
# 旧Cue/Direction向量及离线Direction工具保留各自已有凭据
EMBER_EMBED_API_KEY=
ZHIPU_API_KEY=
# 可选：替换整份无密钥配置；不是按调用位置分别配置
# EMBER_MODELS_CONFIG=/absolute/path/models.json
# 简报预算，见 PROTOCOL_DETAILS.md#briefing
# EMBER_BRIEFING_BUDGET=

# ---- 原文拉取（去原文化 2026-10-14：本地不存原文，按需向后端拉）----
# 提供方 = 后端的 GET /api/source（契约见 API.md §7.2；Deliz 接管后换 URL）
# 未配置 → 拉取链路降级（跨重启的双盲核对/翻原文如实报 not_archived）
EMBER_SOURCE_URL=
EMBER_SOURCE_TOKEN=
# 单次请求超时秒数（默认 8）
#EMBER_SOURCE_TIMEOUT=8

# ---- 服务绑定 ----
# 跨机访问（如 Deliz 从别的机器连入）必须监听 0.0.0.0，并设 EMBER_TOKEN
# EMBER_HOST=0.0.0.0
# 注意变量名是 EMBER_SIDECAR_PORT（默认 8767）——不是 EMBER_PORT
#EMBER_SIDECAR_PORT=8767
# 入站鉴权（Bearer）：设置后所有端点要求 Authorization: Bearer <值>；
# 不设 = 本机自用模式，任何人不拦——跨机部署必须设！
# 生成：openssl rand -hex 24（两端同值：VPS 的 .env 与调用方配置）
#EMBER_TOKEN=

# ---- 多实例（2026-10-17，一颗心一套记忆库）----
# 记忆库根目录 = heart 的 data/ 根目录：default 实例库住 <root>/ember，
# 其余实例住 <root>/instances/<名字>/ember（与 heart 的数据目录布局对齐）
#EMBER_DATA_ROOT=
# 实例清单（逗号分隔，缺省 default）；清单外的实例名一律 404
#EMBER_INSTANCES=default
