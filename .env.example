# Ember v3 — 环境变量模板（复制本文件为 .env 并填入真实值；.env 不入库）
# 各脚本启动时自动加载（load_env）。

# ---- LLM（sleep 维护 / 划分 / 挂载 / Entity summary，智谱）----
ZHIPU_API_KEY=
EMBER_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBER_SLEEP_MODEL=glm-4.7
# 可选：各任务点独立指定模型（缺省回落 EMBER_SLEEP_MODEL）
# EMBER_SPLIT_MODEL=
# EMBER_MOUNT_MODEL=
# EMBER_SUMMARY_MODEL=

# ---- Embedding（硅基流动）----
EMBER_EMBED_API_KEY=
EMBER_EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBER_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# ---- heart 梦通道（v3 契约 2026-10-10）----
# 同机部署填 http://127.0.0.1:<heart端口>；公网填 https://chat.loismclaude.me
# token = heart 服务 smoke_config.json 的 auth_token
HEART_BASE_URL=
HEART_AUTH_TOKEN=
HEART_INSTANCE=default
